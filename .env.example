# ================================================================
# Granja Nidal - Environment Variables
# ================================================================

# --- SUPABASE (Required for production) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- FARM CONFIGURATION ---
# Single-farm mode: The canonical farm UUID
# Set this on Vercel dashboard under Environment Variables
NEXT_PUBLIC_FARM_ID=

# --- DATABASE (Required for /api/admin/setup migration endpoint) ---
# Auto-set by Supabase Vercel integration when connected
POSTGRES_URL=postgres://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
POSTGRES_URL_NON_POOLING=postgres://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# --- APP CONFIGURATION (Optional) ---
# Public URL of the app (used for CSRF protection)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
